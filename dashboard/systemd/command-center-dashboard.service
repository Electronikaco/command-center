[Unit]
Description=Command Center Dashboard (Vite + Express :3099)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/claude/dosmentes/.orchestrator/dashboard
Environment=NODE_ENV=production
Environment=PORT=3099
Environment=PROJECTS_REGISTRY=/home/claude/dosmentes/.orchestrator/dashboard/projects.registry.yaml
Environment=PORTFOLIO_POLL_SEC=60
ExecStart=/home/claude/.local/node/bin/node dist-server/server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
