[Unit]
Description=DosMentes Orchestrator Dashboard (Vite + Express :3099)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/claude/dosmentes/.orchestrator/dashboard
Environment=NODE_ENV=production
Environment=PORT=3099
Environment=POLL_SEC=30
Environment=ORCH_DIR=/home/claude/dosmentes/.orchestrator
Environment=REPO_DIR=/home/claude/dosmentes/dosmentes-front
Environment=GH_REPO=electronikatm/dosmentes-front
ExecStart=/home/claude/.local/node/bin/node dist-server/server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
